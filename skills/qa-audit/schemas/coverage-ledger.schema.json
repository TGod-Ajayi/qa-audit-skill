{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TGod-Ajayi/qa-audit-skill/schemas/coverage-ledger.schema.json",
  "title": "QA audit coverage ledger",
  "type": "object",
  "required": ["run", "build", "p0_journeys", "units"],
  "properties": {
    "run": {"type": "integer", "minimum": 1},
    "build": {"type": "string", "minLength": 1},
    "p0_journeys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "unit"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "pattern": "^U-\\d{3,}$"}
        }
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "area", "kind", "target", "priority", "expected_source", "check_classes", "status", "checks_performed", "source_files"],
        "properties": {
          "id": {"type": "string", "pattern": "^U-\\d{3,}$"},
          "area": {"type": "string", "minLength": 1},
          "kind": {"enum": ["journey", "page", "form", "entity", "api", "state", "integration", "cross-cutting"]},
          "target": {"type": "string", "minLength": 1},
          "priority": {"enum": ["P0", "P1", "P2"]},
          "expected_source": {"type": "string", "minLength": 1},
          "check_classes": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["happy-path", "input", "state", "navigation", "auth", "errors", "timing", "money", "time-locale", "integration", "contract", "responsive", "a11y", "performance", "hygiene"]}
          },
          "status": {"enum": ["pending", "covered", "partial", "blocked"]},
          "blocked_reason": {"type": ["string", "null"]},
          "checks_performed": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["class", "check", "result", "evidence"],
              "properties": {
                "class": {"type": "string"},
                "check": {"type": "string", "minLength": 1},
                "result": {"enum": ["pass", "fail", "blocked"]},
                "evidence": {"type": "array", "items": {"type": "string"}}
              }
            }
          },
          "source_files": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
